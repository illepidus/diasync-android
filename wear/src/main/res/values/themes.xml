<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Diasync.Wear" parent="android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@color/brand_black</item>
        <item name="android:colorBackground">@color/brand_black</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFFFF</item>
        <item name="android:colorAccent">@color/brand_orange</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
        <item name="android:statusBarColor">@color/brand_black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="WearDiagnosticSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">@color/brand_orange</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WearDiagnosticSectionBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:gravity">start</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
