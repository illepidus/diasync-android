<?xml version="1.0" encoding="UTF-8"?>
<WatchFace height="450" width="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="14:48:00" />
    <Scene backgroundColor="#FF000000">
        <DigitalClock height="92" width="340" x="55" y="21">
            <TimeText format="hh:mm" height="92" hourFormat="24" width="340" x="0" y="0">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="72" />
            </TimeText>
        </DigitalClock>

        <PartText height="36" width="220" x="115" y="111">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text>
                <Font color="#FFBDBDBD" family="SYNC_TO_DEVICE" size="22">
                    <Template>
                        <![CDATA[%s %s.%s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[DAY_Z]" />
                        <Parameter expression="[MONTH_Z]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <Condition>
            <Expressions>
                <Expression name="batteryCharging">
                    <![CDATA[[BATTERY_CHARGING_STATUS]]]></Expression>
                <Expression name="batteryCritical"><![CDATA[[BATTERY_PERCENT] <= 15]]></Expression>
            </Expressions>
            <Compare expression="batteryCharging">
                <PartText height="36" width="90" x="45" y="111">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font color="#FF00FF00" family="SYNC_TO_DEVICE" size="22">
                            <Template><![CDATA[%d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Compare expression="batteryCritical">
                <PartText height="36" width="90" x="45" y="111">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font color="#FFFF0000" family="SYNC_TO_DEVICE" size="22">
                            <Template><![CDATA[%d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Default>
                <PartText height="36" width="90" x="45" y="111">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="START">
                        <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="22">
                            <Template><![CDATA[%d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Default>
        </Condition>

        <PartText height="36" width="90" x="315" y="111">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="END">
                <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="22">
                    <Template><![CDATA[%d]]>
                        <Parameter expression="[STEP_COUNT]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <DigitalClock height="112" width="390" x="30" y="126">
            <TimeText alpha="0" format="hh:mm" height="112" hourFormat="24" width="390" x="0" y="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="88" />
            </TimeText>
        </DigitalClock>

        <PartText alpha="0" height="48" width="300" x="75" y="239">
            <Variant mode="AMBIENT" target="alpha" value="220" />
            <Text>
                <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="30">
                    <Template>
                        <![CDATA[%s %s.%s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[DAY_Z]" />
                        <Parameter expression="[MONTH_Z]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <ComplicationSlot displayName="glucose_complication_name"
            height="1"
            slotId="1"
            supportedTypes="EMPTY"
            width="1"
            x="0"
            y="0">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingBox height="1" width="1" x="0" y="0" />
