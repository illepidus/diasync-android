<?xml version="1.0" encoding="UTF-8"?>
<WatchFace height="450" width="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="14:48:00" />
    <Scene backgroundColor="#FF000000">
        <DigitalClock height="88" width="330" x="60" y="25">
            <TimeText format="hh:mm" height="88" hourFormat="24" width="330" x="0" y="0">
                <Variant mode="AMBIENT" target="alpha" value="220" />
                <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="68" />
            </TimeText>
        </DigitalClock>

        <PartText height="38" width="220" x="115" y="111">
            <Variant mode="AMBIENT" target="alpha" value="190" />
            <Text>
                <Font color="#FFBDBDBD" family="SYNC_TO_DEVICE" size="24">
                    <Template>
                        <![CDATA[%s %s.%s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[DAY_Z]" />
                        <Parameter expression="[MONTH_Z]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <Condition>
            <Expressions>
                <Expression name="batteryCharging">
                    <![CDATA[[BATTERY_CHARGING_STATUS]]]></Expression>
                <Expression name="batteryCritical"><![CDATA[[BATTERY_PERCENT] <= 15]]></Expression>
            </Expressions>
            <Compare expression="batteryCharging">
                <PartText height="38" width="90" x="45" y="111">
                    <Variant mode="AMBIENT" target="alpha" value="200" />
                    <Text align="START">
                        <Font color="#FF00FF00" family="SYNC_TO_DEVICE" size="24">
                            <Template><![CDATA[%d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Compare expression="batteryCritical">
                <PartText height="38" width="90" x="45" y="111">
                    <Variant mode="AMBIENT" target="alpha" value="200" />
                    <Text align="START">
                        <Font color="#FFFF0000" family="SYNC_TO_DEVICE" size="24">
                            <Template><![CDATA[%d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Default>
                <PartText height="38" width="90" x="45" y="111">
                    <Variant mode="AMBIENT" target="alpha" value="200" />
                    <Text align="START">
                        <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="24">
                            <Template><![CDATA[%d%%]]>
                                <Parameter expression="[BATTERY_PERCENT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Default>
        </Condition>

        <ComplicationSlot displayName="glucose_complication_name"
            height="1"
            slotId="1"
            supportedTypes="EMPTY"
            width="1"
            x="0"
            y="0">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingBox height="1" width="1" x="0" y="0" />
        </ComplicationSlot>

        <ComplicationSlot displayName="glucose_ambient_complication_name"
            height="235"
            slotId="3"
            supportedTypes="LONG_TEXT EMPTY"
            width="360"
            x="45"
            y="150">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"
                primaryProvider="ru.krotarnya.diasync2/ru.krotarnya.diasync2.wear.DiasyncComplicationDataSourceService"
                primaryProviderType="LONG_TEXT" />
            <BoundingBox height="235" width="360" x="0" y="0" />
            <Complication type="LONG_TEXT">
                <PartImage height="235" width="360" x="0" y="0">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
                <PartText alpha="0" height="235" width="360" x="0" y="0">
                    <Variant mode="AMBIENT" target="alpha" value="255" />
                    <Text>
                        <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="60">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot displayName="glucose_status_complication_name"
            height="38"
            slotId="2"
            supportedTypes="SHORT_TEXT EMPTY"
            width="250"
            x="100"
            y="392">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"
                primaryProvider="ru.krotarnya.diasync2/ru.krotarnya.diasync2.wear.DiasyncComplicationDataSourceService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingBox height="38" width="250" x="0" y="0" />
            <Complication type="SHORT_TEXT">
                <PartText height="38" width="250" x="0" y="0">
                    <Variant mode="AMBIENT" target="alpha" value="220" />
                    <Text>
                        <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="23">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
