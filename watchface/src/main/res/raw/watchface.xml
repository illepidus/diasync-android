<?xml version="1.0" encoding="UTF-8"?>
<WatchFace height="450" width="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="14:48:00" />
    <Scene backgroundColor="#FF000000">
        <DigitalClock height="92" width="330" x="60" y="54">
            <TimeText
                align="CENTER"
                format="hh:mm"
                height="92"
                hourFormat="24"
                width="330"
                x="0"
                y="0">
                <Variant mode="AMBIENT" target="alpha" value="220" />
                <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="64" />
            </TimeText>
        </DigitalClock>

        <PartText height="42" width="300" x="75" y="142">
            <Variant mode="AMBIENT" target="alpha" value="200" />
            <Text align="CENTER">
                <Font color="#FFBDBDBD" family="SYNC_TO_DEVICE" size="25">
                    <Template>
                        <![CDATA[%s %s.%s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[DAY_Z]" />
                        <Parameter expression="[MONTH_Z]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <ComplicationSlot
            displayName="glucose_complication_name"
            height="150"
            slotId="1"
            supportedTypes="SHORT_TEXT EMPTY"
            width="330"
            x="60"
            y="210">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"
                primaryProvider="ru.krotarnya.diasync2/ru.krotarnya.diasync2.wear.DiasyncComplicationDataSourceService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingBox height="150" width="330" x="0" y="0" />
            <Complication type="SHORT_TEXT">
                <PartText height="150" width="330" x="0" y="0">
                    <Variant mode="AMBIENT" target="alpha" value="220" />
                    <Text align="CENTER">
                        <Font color="#FFFFFFFF" family="SYNC_TO_DEVICE" size="54">
                            <Template>
                                <![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
