<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configuration_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

        <EditText
            android:id="@+id/backend_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:autofillHints="url"
            android:hint="@string/backend_url"
            android:inputType="textUri"
            android:maxLines="1" />

        <EditText
            android:id="@+id/user_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:hint="@string/user_id"
            android:inputType="textPassword"
            android:maxLines="1" />

        <Spinner
            android:id="@+id/glucose_unit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/glucose_unit" />

        <CheckBox
            android:id="@+id/use_calibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/use_calibration" />

        <EditText
            android:id="@+id/low_threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/low_threshold_mmol"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:text="@string/default_low_threshold" />

        <EditText
            android:id="@+id/high_threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/high_threshold_mmol"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:text="@string/default_high_threshold" />

        <Spinner
            android:id="@+id/widget_graph_window"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/widget_graph_window" />

        <CheckBox
            android:id="@+id/widget_graph_zones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/widget_graph_zones" />

        <CheckBox
            android:id="@+id/widget_graph_lines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/widget_graph_lines" />

        <CheckBox
            android:id="@+id/widget_trend_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/widget_trend_arrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/alert_settings_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <CheckBox
            android:id="@+id/low_alert_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/low_alert_enabled" />

        <CheckBox
            android:id="@+id/high_alert_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/high_alert_enabled" />

        <CheckBox
            android:id="@+id/no_data_alert_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/no_data_alert_enabled" />

        <Spinner
            android:id="@+id/snooze_duration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/snooze_duration" />

        <Button
            android:id="@+id/snooze_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/snooze_alerts" />

        <TextView
            android:id="@+id/snooze_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:visibility="gone" />

        <Button
            android:id="@+id/monitoring_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start_monitoring" />

        <TextView
            android:id="@+id/monitoring_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/monitoring_disabled"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <TextView
            android:id="@+id/latest_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
            android:visibility="gone" />

        <TextView
            android:id="@+id/latest_timestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
